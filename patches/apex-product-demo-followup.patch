+const OverlayButton = ({
+  icon,
+  ariaLabel,
+  onClick,
+}: {
+  icon: React.ReactNode;
+  ariaLabel: string;
+  onClick: (event: React.MouseEvent<HTMLButtonElement>) => void;
+}) => (
+  <button
+    type="button"
+    aria-label={ariaLabel}
+    onClick={onClick}
+    className="inline-flex h-10 w-10 items-center justify-center rounded-full text-white transition-colors hover:bg-white/10 focus-visible:bg-white/10"
+  >
+    <span className="flex h-full w-full items-center justify-center">{icon}</span>
+  </button>
+);
+
+const InteractiveVideoFrame = ({
+  item,
+  className = '',
+  cropLeft = 0,
+  objectFit = 'cover',
+}: {
+  item: MediaItem;
+  className?: string;
+  cropLeft?: number;
+  objectFit?: 'cover' | 'contain';
+}) => {
+  const inlineVideoRef = useRef<HTMLVideoElement | null>(null);
+  const modalVideoRef = useRef<HTMLVideoElement | null>(null);
+  const [isPlaying, setIsPlaying] = useState(false);
+  const [isExpanded, setIsExpanded] = useState(false);
+
+  const inlineVideoStyle: CSSProperties =
+    cropLeft > 0
+      ? {
+          width: `calc(100% + ${cropLeft}px)`,
+          maxWidth: 'none',
+          transform: `translateX(-${cropLeft}px)`,
+        }
+      : {};
+
+  const playInline = async () => {
+    if (!inlineVideoRef.current) return;
+    if (inlineVideoRef.current.ended) {
+      inlineVideoRef.current.currentTime = 0;
+    }
+    await inlineVideoRef.current.play();
+    setIsPlaying(true);
+  };
+
+  const pauseInline = () => {
+    if (!inlineVideoRef.current) return;
+    inlineVideoRef.current.pause();
+    setIsPlaying(false);
+  };
+
+  const togglePlayback = async (event: React.MouseEvent<HTMLButtonElement>) => {
+    event.preventDefault();
+    event.stopPropagation();
+    if (isPlaying) {
+      pauseInline();
+      return;
+    }
+    await playInline();
+  };
+
+  const handleMouseEnter = () => {
+    void playInline();
+  };
+
+  const handleMouseLeave = () => {
+    pauseInline();
+  };
+
+  const openExpanded = async (event: React.MouseEvent<HTMLButtonElement>) => {
+    event.preventDefault();
+    event.stopPropagation();
+    setIsExpanded(true);
+  };
+
+  const closeExpanded = () => {
+    if (modalVideoRef.current) {
+      modalVideoRef.current.pause();
+    }
+    setIsExpanded(false);
+  };
+
+  useEffect(() => {
+    if (!isExpanded || !modalVideoRef.current || !inlineVideoRef.current) return;
+
+    modalVideoRef.current.currentTime = inlineVideoRef.current.currentTime;
+    if (isPlaying) {
+      void modalVideoRef.current.play();
+    }
+  }, [isExpanded, isPlaying]);
+
+  const isContained = objectFit === 'contain';
+  const inlineVideoClassName = `h-full bg-[var(--brand-sand)] ${
+    isContained ? 'w-auto max-w-full object-contain' : 'w-full object-cover'
+  }`;
+
+  return (
+    <>
+      <div
+        className={`group flex items-center justify-start overflow-visible ${className}`}
+        onMouseEnter={handleMouseEnter}
+        onMouseLeave={handleMouseLeave}
+      >
+        <div className="relative flex h-full max-w-full items-center justify-center overflow-hidden rounded-md">
+          <video
+            ref={inlineVideoRef}
+            src={item.src}
+            muted
+            playsInline
+            preload="metadata"
+            className={inlineVideoClassName}
+            style={inlineVideoStyle}
+          />
+          <div className="pointer-events-none absolute inset-x-0 bottom-0 h-20 bg-gradient-to-t from-[rgba(15,23,42,0.34)] via-[rgba(15,23,42,0.12)] to-transparent" />
+          <div className="absolute bottom-3 right-3 inline-flex items-center gap-0.5 rounded-full border border-white/12 bg-[rgba(15,23,42,0.68)] p-1.5 shadow-[0_12px_30px_rgba(15,23,42,0.28)] backdrop-blur-md">
+            <OverlayButton
+              ariaLabel={isPlaying ? 'Pause video' : 'Play video'}
+              icon={isPlaying ? <LuPause className="h-4.5 w-4.5" /> : <LuPlay className="h-4.5 w-4.5 translate-x-[1px]" />}
+              onClick={togglePlayback}
+            />
+            <OverlayButton
+              ariaLabel="Enlarge video"
+              icon={<LuExpand className="h-4.5 w-4.5" />}
+              onClick={openExpanded}
+            />
+          </div>
+        </div>
+      </div>
+      {isExpanded ? createPortal(
+        <div
+          className="fixed inset-0 z-[200] flex items-center justify-center bg-[rgba(2,6,23,0.72)] p-6 backdrop-blur-[6px]"
+          onClick={closeExpanded}
+        >
+          <div
+            className="relative w-full max-w-5xl overflow-hidden rounded-[28px] border border-white/10 bg-[#0f172a] shadow-[0_24px_80px_rgba(0,0,0,0.45)]"
+            onClick={(event) => event.stopPropagation()}
+          >
+            <video
+              ref={modalVideoRef}
+              src={item.src}
+              muted
+              playsInline
+              loop
+              controls={false}
+              preload="metadata"
+              className="max-h-[82vh] w-full bg-[#0f172a] object-contain"
+            />
+            <div className="pointer-events-none absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-[rgba(2,6,23,0.5)] via-[rgba(2,6,23,0.12)] to-transparent" />
+            <div className="absolute bottom-4 right-4 inline-flex items-center gap-0.5 rounded-full border border-white/12 bg-[rgba(15,23,42,0.72)] p-1.5 shadow-[0_12px_30px_rgba(0,0,0,0.32)] backdrop-blur-md">
+              <OverlayButton
+                ariaLabel={isPlaying ? 'Pause video' : 'Play video'}
+                icon={isPlaying ? <LuPause className="h-4.5 w-4.5" /> : <LuPlay className="h-4.5 w-4.5 translate-x-[1px]" />}
+                onClick={(event) => {
+                  event.preventDefault();
+                  event.stopPropagation();
+                  if (!modalVideoRef.current) return;
+                  if (modalVideoRef.current.paused) {
+                    void modalVideoRef.current.play();
+                    setIsPlaying(true);
+                  } else {
+                    modalVideoRef.current.pause();
+                    setIsPlaying(false);
+                  }
+                }}
+              />
+              <OverlayButton
+                ariaLabel="Close expanded video"
+                icon={<LuX className="h-4.5 w-4.5" />}
+                onClick={(event) => {
+                  event.preventDefault();
+                  event.stopPropagation();
+                  closeExpanded();
+                }}
+              />
+            </div>
+          </div>
+        </div>
+      , document.body) : null}
+    </>
+  );
+};
+
